{
  "name": "@tecnobray/backend",
  "version": "0.1.0",
  "private": true,
  "description": "API de la tienda TecnoBray (NestJS + TypeORM + PostgreSQL + S3)",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.spec.json",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d src/database/data-source.ts",
    "migration:run": "pnpm typeorm migration:run",
    "migration:revert": "pnpm typeorm migration:revert",
    "migration:generate": "pnpm typeorm migration:generate",
    "migration:run:prod": "typeorm migration:run -d dist/database/data-source.js",
    "storage:init": "ts-node -r tsconfig-paths/register src/scripts/storage-init.ts",
    "seed": "ts-node -r tsconfig-paths/register src/scripts/seed.ts",
    "seed:demo": "ts-node -r tsconfig-paths/register src/scripts/seed-demo.ts",
    "brand:apply": "ts-node -r tsconfig-paths/register src/scripts/brand-apply.ts",
    "seed:prod": "node dist/scripts/seed.js",
    "brand:apply:prod": "node dist/scripts/brand-apply.js",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1147.0",
    "@aws-sdk/s3-request-presigner": "3.1147.0",
    "@nestjs/common": "12.1.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.2",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/typeorm": "12.0.2",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.6",
    "helmet": "8.3.0",
    "marked": "18.1.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sanitize-html": "2.18.1",
    "sharp": "0.35.5",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.6",
    "@nestjs/testing": "12.1.2",
    "@swc/core": "1.16.13",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.5",
    "@types/sanitize-html": "2.16.2",
    "@types/supertest": "7.2.1",
    "eslint": "10.12.0",
    "supertest": "7.3.1",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.3"
  }
}
