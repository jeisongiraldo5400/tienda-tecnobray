# =============================================================
# TecnoBray backend — variables de entorno (copiar a .env)
# Nunca subas .env al repositorio. Todos los valores de abajo son ejemplos.
# =============================================================

NODE_ENV=development
PORT=4001
# URL pública de este backend (se usa para construir las URLs /api/media/... de las imágenes)
PUBLIC_API_URL=http://localhost:4001
# Confianza en proxies para req.ip (por defecto false). La IP real de los clientes que llegan
# por el BFF del frontend se toma de X-BFF-Client-IP / X-Forwarded-For SOLO si la solicitud trae
# X-BFF-Secret = BFF_SHARED_SECRET.
# TRUST_PROXY=false
# Secreto compartido con el BFF de Next (mismo valor que BFF_SHARED_SECRET en el frontend)
BFF_SHARED_SECRET=cambia-esto-por-un-valor-aleatorio-largo

# --- Frontend ---
# Orígenes permitidos por CORS (separados por coma)
FRONTEND_ORIGIN=http://localhost:3002
# URL del frontend para el webhook de revalidación ISR (POST ${FRONTEND_URL}/api/revalidate)
FRONTEND_URL=http://localhost:3002
# Mismo valor que REVALIDATE_SECRET en el frontend
REVALIDATE_SECRET=cambia-esto-por-un-valor-aleatorio-largo

# --- Base de datos (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tecnobray_tienda
DB_USERNAME=tecnobray
DB_PASSWORD=cambia-esto
# TLS verificado (rejectUnauthorized siempre true). En Railway: CA + servername.
DB_SSL=false
# DB_SSL_CA_FILE=./.certs/railway-ca.pem
# DB_SSL_SERVERNAME=localhost
# DB_POOL_MAX=10
# DB_LOGGING=false

# --- Sesión del panel ---
# Secretos distintos de al menos 32 caracteres: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# JWT_ACCESS_TTL_SECONDS=900
# JWT_REFRESH_TTL_DAYS=7
# Cookies Secure (true por defecto en producción)
COOKIE_SECURE=false
# COOKIE_DOMAIN=
# Ruta de la cookie de refresh si el frontend usa otro prefijo para el proxy (por defecto /api/auth)
# REFRESH_COOKIE_PATH=/api/auth

# --- Almacenamiento de imágenes (S3, obligatorio) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=tecnobray
# Prefijo opcional antepuesto a todas las llaves (ej. "tienda")
S3_PREFIX=
# Solo para MinIO / Cloudflare R2 / otros S3 compatibles:
# S3_ENDPOINT=http://127.0.0.1:9010
# S3_FORCE_PATH_STYLE=true
# CloudFront o URL pública del bucket. Si se define, MEDIA_DELIVERY pasa a "public" por defecto.
# S3_PUBLIC_BASE_URL=https://dxxxxxxxx.cloudfront.net
# proxy (por defecto, bucket privado: el backend sirve las imágenes) | redirect (URL firmada) | public
MEDIA_DELIVERY=proxy

# --- Seed del primer administrador (pnpm seed) ---
SEED_ADMIN_EMAIL=admin@tecnobray.co
SEED_ADMIN_NAME=Administrador TecnoBray
# Mínimo 10 caracteres. Genera uno aleatorio, no uses contraseñas reales de otros sistemas.
SEED_ADMIN_PASSWORD=
# SEED_ADMIN_RESET=true   # restablece la contraseña del admin existente
