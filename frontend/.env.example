# --- Backend (solo servidor) ---
# URL base del backend NestJS (sin barra final). Los componentes de servidor y el BFF lo llaman directamente.
API_BASE_URL=http://127.0.0.1:4001
# Prefijo global de rutas del backend (setGlobalPrefix). Vacío o "/" si no usa prefijo.
API_PREFIX=/api

# --- Sitio público ---
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# --- Revalidación ISR bajo demanda ---
# Secreto compartido con el backend: debe enviarlo en la cabecera `x-revalidate-secret`
# (o `Authorization: Bearer <secreto>`) al llamar POST /api/revalidate. Genera uno largo y aleatorio.
REVALIDATE_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
# Segundos de ISR por defecto para datos públicos.
ISR_REVALIDATE_SECONDS=300

# --- Confianza BFF → backend (solo servidor, NUNCA NEXT_PUBLIC_) ---
# Mismo valor que BFF_SHARED_SECRET en el backend. El BFF lo envía como `X-BFF-Secret` junto con
# `X-BFF-Client-IP` (IP real del cliente) para que el throttling del backend sea por cliente.
BFF_SHARED_SECRET=

# --- Imágenes remotas (next/image remotePatterns) ---
# Lista separada por comas: URL pública de medios del backend (/api/media), bucket S3, CloudFront
# y, en desarrollo, MinIO local. Admite ruta: https://api.midominio.com/api/media
NEXT_IMAGE_REMOTE_HOSTS=http://localhost:4001/api/media,http://127.0.0.1:4001/api/media,https://*.s3.amazonaws.com,https://*.s3.us-east-1.amazonaws.com,https://*.cloudfront.net,http://127.0.0.1:9010,http://localhost:9010

# --- Sesión del panel (deben coincidir con las cookies que emite el backend) ---
ADMIN_ACCESS_COOKIE=tb_at
ADMIN_REFRESH_COOKIE=tb_rt
NEXT_PUBLIC_CSRF_COOKIE=tb_csrf
NEXT_PUBLIC_CSRF_HEADER=x-csrf-token
